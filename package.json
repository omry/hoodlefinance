{
  "name": "hoodlefinance",
  "private": true,
  "license": "MPL-2.0",
  "description": "Local development tooling for the HOODLEFINANCE Apps Script project.",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "test": "npm run test:hoodlefinance && npm run test:release && npm run test:sync-demo-sheet && npm run test:deploy-addon",
    "test:hoodlefinance": "node --test test/hoodlefinance.test.js",
    "test:release": "node --test test/release.test.js",
    "test:sync-demo-sheet": "node --test test/sync-demo-sheet.test.js",
    "test:deploy-addon": "node --test test/deploy-addon.test.js",
    "check": "npm run check:syntax",
    "check:syntax": "node --check hoodlefinance.js && node --check test/hoodlefinance.test.js && node --check tools/release.js && node --check test/release.test.js && node --check tools/credential-context.js && node --check tools/sync-demo-sheet.js && node --check test/sync-demo-sheet.test.js && node --check tools/deploy-addon.js && node --check tools/show-clasp-user.js && node --check test/deploy-addon.test.js",
    "smoke": "node tools/cli.js",
    "pse:refresh": "node tools/generate-pse-isin-map.js",
    "release:check-fragments": "sh tools/check-release-fragments.sh",
    "hooks:install": "sh tools/install-git-hooks.sh",
    "release:prepare": "node tools/release.js prepare",
    "release:publish": "node tools/release.js publish",
    "benchmark": "node tools/benchmark.js",
    "demo:sync": "node tools/sync-demo-sheet.js",
    "demo:sync:staging": "node tools/sync-demo-sheet.js --staging",
    "demo:sync:staging:dry-run": "node tools/sync-demo-sheet.js --staging --dry-run",
    "demo:sync:production": "node tools/sync-demo-sheet.js --production",
    "demo:sync:production:dry-run": "node tools/sync-demo-sheet.js --production --dry-run",
    "clasp:user": "node tools/show-clasp-user.js",
    "addon:deploy": "node tools/deploy-addon.js",
    "addon:deploy:staging": "node tools/deploy-addon.js --staging",
    "addon:deploy:staging:dry-run": "node tools/deploy-addon.js --staging --dry-run",
    "addon:deploy:production": "node tools/deploy-addon.js --production",
    "addon:deploy:production:dry-run": "node tools/deploy-addon.js --production --dry-run",
    "support-matrix": "python3 tools/generate-support-matrix.py",
    "fx-coverage": "python3 tools/map-google-fx-coverage.py"
  },
  "devDependencies": {
    "@google/clasp": "3.1.3"
  }
}
